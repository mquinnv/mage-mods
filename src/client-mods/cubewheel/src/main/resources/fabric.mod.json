{
  "schemaVersion": 1,
  "id": "cubewheel",
  "version": "${version}",
  "name": "CubeWheel (unofficial ManaCube helper)",
  "description": "Unofficial client-side helper for ManaCube Survival: a radial command wheel for vaults, shops, warps and homes, plus a passive quest/job progress tracker. Not affiliated with ManaCube.",
  "authors": ["Mage Realism"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["net.mage.cubewheel.CubeWheelClient"],
    "modmenu": ["net.mage.cubewheel.settings.ModMenuEntry"]
  },
  "mixins": [{ "config": "cubewheel.mixins.json", "environment": "client" }],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "yet_another_config_lib_v3": ">=3.9.7"
  },
  "suggests": {
    "modmenu": "*"
  }
}
